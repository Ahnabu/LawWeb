# Islam & Associates International Frontend Environment Variables

# 1. Backend API Base URL (Required)
# URL of your deployed Express backend (no trailing slash)
# Example for Vercel deployment: https://islamassociates-api.vercel.app
# Example for custom domain: https://api.islamandassociates.com
# Example for local development: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# 2. Canonical Site URL (Recommended for Production / SEO)
# The public domain of your frontend deployment (no trailing slash)
# Example: https://islamandassociates.com or https://islamassociates-frontend.vercel.app
# If omitted on Vercel, VERCEL_PROJECT_PRODUCTION_URL will be used as a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. On-Demand CMS Revalidation Secret (Recommended)
# Must match REVALIDATE_SECRET configured on the backend
# Used by /api/revalidate to instantly purge cached CMS pages upon publish
REVALIDATE_SECRET=
