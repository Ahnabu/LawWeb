# Copy to .env for local development. Never commit real values.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Frontend origin(s) allowed by CORS and the CSRF origin check, comma-separated
CLIENT_URL=http://localhost:3000
# Origin used in email links (password reset, lawyer setup). Defaults to the first CLIENT_URL.
FRONTEND_URL=http://localhost:3000

# Two different random strings, 32+ characters each (required, checked at startup).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookies. "none" is required while frontend and API are on different sites
# (e.g. *.vercel.app + *.onrender.com). Use "lax" once both share one domain.
COOKIE_SAMESITE=none
# Production only, and only when the frontend and API share a parent domain (e.g. .example.com)
COOKIE_DOMAIN=

# Number of reverse-proxy hops in front of Express (1 on Render/Railway/Heroku). Leave empty locally.
TRUST_PROXY=

# Email (Resend). Without RESEND_API_KEY in development, codes and links are printed to the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LawWeb <onboarding@resend.dev>
# Development only: send every email here (the resend.dev sender can only reach the account owner)
RESEND_TEST_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: instant CMS publish
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Admin seed script (npm run seed:admin). Password is required in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
